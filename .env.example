# 复制本文件为 .env 后填入你自己的值
# Copy this file to .env and fill in your own values

# ===== hupu账号（必填）=====
HUPU_USERNAME=
HUPU_PASSWORD=

# ===== AI 回复 API Key（任选一个）=====
# 优先级：Groq > Gemini > DeepSeek > OpenAI
# 任意一个有值即可，脚本自动按优先级使用

# Groq（推荐！完全免费，无需绑卡）申请: https://console.groq.com
GROQ_API_KEY=

# Gemini 申请: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# DeepSeek（极便宜，约 1 元/百万 token）申请: https://platform.deepseek.com
DEEPSEEK_API_KEY=

# OpenAI（备选）申请: https://platform.openai.com
OPENAI_API_KEY=
